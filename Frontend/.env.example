# Backend base URL (leave empty in dev to use the Vite proxy -> http://localhost:8000)
VITE_API_BASE_URL=

# Map tiles (Leaflet). Default: OpenStreetMap standard tiles (no key; fair-use policy applies).
# For production use a tile provider, e.g. MapTiler: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# ---------- Backend (copy to backend/.env or project-root .env) ----------
MONGODB_URI=mongodb+srv://jirapatrue_db_user:7DuYJUgVX0YhLzoh@chill-with-me.hhjfbnk.mongodb.net/
MONGODB_DB=chill_with_me

# Folder containing thailand_master_places.csv and thailand_master_reviews.csv
DATA_DIR=../data
# ML_ARTIFACTS_DIR=./ml/artifacts

# Routing provider: auto | ors | google | osrm | mock
#   auto = use whichever real provider below is configured, otherwise mock (clearly labelled estimates)
ROUTING_PROVIDER=auto
# OpenRouteService key: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# Google Maps Platform key with "Routes API" enabled
GOOGLE_MAPS_API_KEY=
# Self-hosted OSRM, e.g. http://localhost:5000  (no key needed)
OSRM_BASE_URL=
# When a real provider fails, return labelled mock estimates instead of an error
ROUTING_FALLBACK_TO_MOCK=true
ROUTING_TIMEOUT_S=12

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
